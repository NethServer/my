metadata:
  name: "my-rbac-config"
  version: "1.0.0"
  description: "RBAC configuration for my application"

# HOW TO USE THIS FILE
#
# Roles, permissions and resources below are the real vocabulary the deployed
# tenants run on: `sync sync` reconciles a Logto tenant against exactly this,
# and backend/authz/routes.yml states each endpoint's intent in the same terms.
# Keep them in step — a permission that exists only here, or only there, is a
# permission nobody enforces.
#
# What is NOT real here is everything from `third_party_apps` down: tenant ids,
# application URLs, SMTP credentials and branding are per-environment, and the
# files that hold them (config.yml, config.qa.yml, config.production.yml) are
# gitignored. Copy this file, fill those sections in, and keep the vocabulary
# identical across environments.

# Business hierarchy: owner -> distributor -> reseller -> customer.
# Each role sees only what sits below it in the commercial chain.
organization_roles:
  - id: owner
    name: "Owner"
    priority: 1
    type: org
    permissions:
      # Complete control over commercial hierarchy
      - id: read:distributors
      - id: manage:distributors
      - id: destroy:distributors
      - id: read:resellers
      - id: manage:resellers
      - id: destroy:resellers
      - id: read:customers
      - id: manage:customers
      - id: destroy:customers

  - id: distributor
    name: "Distributor"
    priority: 2
    type: org
    permissions:
      # Can manage downstream in hierarchy resellers and customers
      - id: read:resellers
      - id: manage:resellers
      - id: read:customers
      - id: manage:customers

  - id: reseller
    name: "Reseller"
    priority: 3
    type: org
    permissions:
      # Can only manage customers
      - id: read:customers
      - id: manage:customers

  - id: customer
    name: "Customer"
    priority: 4
    type: org
    permissions:
      # Read-only access to own organization data

# User roles define TECHNICAL CAPABILITIES
# Independent of business hierarchy - define what technical operations a user can perform
user_roles:
  - id: admin
    name: "Admin"
    priority: 1
    type: user
    permissions:
      # Full technical control including dangerous operations
      - id: read:systems        # Simple read operation
      - id: manage:systems      # Standard system management

      - id: read:users          # Simple read operation
      - id: manage:users        # Standard account management

      - id: read:applications   # Simple read operation
      - id: manage:applications # Standard applications management

      - id: read:alerts         # View alerting configuration (own + inherited)
      - id: manage:alerts       # Manage alerting configuration policy (recipients, language, severity/system overrides)

      - id: read:entitlements   # See add-on licenses and expirations
      - id: manage:entitlements # Buy/cancel add-on subscriptions on the shop

      - id: read:rebranding     # See the branding of own organization
      - id: manage:rebranding   # Configure logos, favicon and brand name

  - id: support
    name: "Support"
    priority: 2
    type: user
    permissions:
      # Standard technical operations (no dangerous operations)
      - id: read:systems         # Simple read operation
      - id: manage:systems       # Standard system management

      - id: read:applications    # Simple read operation
      - id: manage:applications  # Standard applications management

      - id: read:alerts          # View alerting configuration (own + inherited)
      - id: manage:alerts        # Manage alerting configuration policy (recipients, language, severity/system overrides)

      - id: read:entitlements    # See add-on licenses and expirations

      - id: read:rebranding      # See the branding of own organization

  - id: backoffice
    name: "Backoffice"
    priority: 2
    type: user
    permissions:
      # Standard technical operations (no dangerous operations)
      - id: read:users           # Simple read operation
      - id: manage:users         # Standard user management

      - id: read:systems         # Simple read systems
      - id: read:applications    # Simple read operation
      - id: manage:applications  # Standard applications management

      - id: read:entitlements    # See add-on licenses and expirations
      - id: manage:entitlements  # Grant/revoke add-on licenses (backoffice duty)

      - id: read:rebranding      # See the branding of own organization

  - id: reader
    name: "Reader"
    priority: 2
    type: user
    permissions:
      # Only readable resources
        - id: read:systems
        - id: read:users
        - id: read:applications
        - id: read:entitlements
        - id: read:rebranding

  - id: super
    name: "Super Admin"
    priority: 0
    type: user
    permissions:
      # Complete control including most dangerous operations
      - id: read:systems
      - id: manage:systems
      - id: destroy:systems
      - id: read:users
      - id: manage:users
      - id: destroy:users
      - id: impersonate:users
      - id: connect:systems
      - id: read:applications
      - id: manage:applications
      - id: read:alerts
      - id: manage:alerts
      - id: config:alerts
      - id: read:entitlements
      - id: manage:entitlements
      - id: read:rebranding
      - id: manage:rebranding
    # Access control: only Owner users can assign this role
    access_control:
      organization_roles:
        - "owner"

# Resources and their available actions.
#
# Scope names are always "{action}:{name}", which is what roles and the backend
# match on. "container" says which Logto API resource hosts those scopes: Logto
# bills per API resource and includes 3 in the Pro plan, so everything shares a
# single container. Omitting it creates one Logto resource per entry.
resources:
  - name: "distributors"
    actions: ["read", "manage", "destroy"]
    container: "permissions"

  - name: "resellers"
    actions: ["read", "manage", "destroy"]
    container: "permissions"

  - name: "customers"
    actions: ["read", "manage", "destroy"]
    container: "permissions"

  - name: "systems"
    actions: ["read", "manage", "destroy", "connect"]
    container: "permissions"

  - name: "entitlements"
    actions: ["read", "manage"]
    container: "permissions"

  - name: "users"
    actions: ["read", "manage", "destroy", "impersonate"]
    container: "permissions"

  - name: "applications"
    actions: ["read", "manage"]
    container: "permissions"

  - name: "alerts"
    actions: ["read", "manage", "config"]
    container: "permissions"

  - name: "rebranding"
    actions: ["read", "manage"]
    container: "permissions"

  - name: "role-access-control"
    actions: ["owner", "distributor", "reseller"]
    container: "permissions"

# Third-party applications
third_party_apps:
    # Example: Management app - only accessible by specific organizations and roles
    - name: "management.company.com"
      description: "Management interface for system administrators"
      display_name: "Management Console"
      info_url: "https://management.company.com/info"
      redirect_uris:
        - "https://management.company.com/callback"
        - "https://management.company.com/auth/callback"
      post_logout_redirect_uris:
        - "https://management.company.com"
        - "https://management.company.com/logout"
      access_control:
        organization_ids:    # Only specific organization IDs can access (optional)
          - "org-headquarters"
          - "org-main-branch"
        organization_roles:  # Only specific organization roles can access
          - "owner"
        user_roles:          # Only specific user roles can access
          - "support"

    # Example: Support portal - accessible by multiple roles
    - name: "support.company.com"
      description: "Support portal for customer assistance"
      display_name: "Support Portal"
      info_url: "https://support.company.com/info"
      redirect_uris:
        - "https://support.company.com/callback"
      post_logout_redirect_uris:
        - "https://support.company.com"
      access_control:
        organization_roles:  # Multiple organization roles can access
          - "owner"
          - "distributor"
        user_roles:          # Multiple user roles can access
          - "support"

    # Example: Customer portal - accessible by all organization roles
    - name: "portal.company.com"
      description: "Customer portal for all users"
      display_name: "Customer Portal"
      info_url: "https://portal.company.com/info"
      redirect_uris:
        - "https://portal.company.com/callback"
      post_logout_redirect_uris:
        - "https://portal.company.com"
      access_control:
        organization_roles:  # All organization roles can access
          - "reseller"
        user_roles:          # All user roles can access
          - "support"

    # Example with custom scopes and access control
    - name: "api.example.com"
      description: "API service application"
      display_name: "API Service"
      info_url: "https://api.example.com/info"
      redirect_uris:
        - "https://api.example.com/auth/callback"
      access_control:
        organization_roles:
          - "distributor"
        user_roles:
          - "support"
      scopes:
        - "profile"
        - "email"
        - "api:read"
        - "api:write"

# Sign-in experience configuration (optional)
sign_in_experience:
  # Brand colors (hex format)
  colors:
    primary_color: "#0069A8"
    primary_color_dark: "#0087DB"
    dark_mode_enabled: true

  # Branding assets (relative paths from config file directory)
  branding:
    logo_path: "sign-in/logo.png"
    logo_dark_path: "sign-in/logo-dark.png"
    favicon_path: "sign-in/favicon.ico"
    favicon_dark_path: "sign-in/favicon-dark.ico"

  # Custom CSS (relative path from config file directory)
  custom_css_path: "sign-in/default.css"

  # Language configuration
  language:
    auto_detect: true
    fallback_language: "en"

  # Sign-in methods configuration
  sign_in:
    methods:
      - identifier: "email"
        password: true
        verification_code: false
        is_password_primary: true

  # Sign-up configuration (disabled by default)
  sign_up:
    identifiers: []
    password: false
    verify: false
    secondary_identifiers: []

  # Social sign-in configuration (empty by default)
  social_sign_in: {}

# Connectors configuration (optional)
connectors:
  # SMTP email connector for password reset and verification emails
  smtp:
    # SMTP server configuration
    host: "smtp.your-provider.com"
    port: 587
    username: "your-smtp-username"
    password: "your-smtp-password"
    from_email: "no-reply@your-company.com"
    from_name: "Your Company Name"
    tls: true
    secure: false
    debug: false
    logger: true
    disable_file_access: true
    disable_url_access: true
    
    # Template variable settings
    template_settings:
      company_name: "Your Company Name"
      support_email: "support@your-company.com"
    
    # Custom headers (optional)
    custom_headers: {}
