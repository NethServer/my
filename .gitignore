# Binaries
backend/backend
backend/main
backend/build/
backend/*.exe
sync/build/
sync/sync
collect/collect
collect/main
collect/build/
collect/*.exe
*.exe
*.bin

# Go build artifacts
go.work
go.work.sum
*.so
*.dylib
*.dll

# Test coverage reports
coverage.out
coverage.html

# Environment files
.env
.env.local
.env.production
.env.*
!.env.example

# Config files - exclude actual configs, keep examples
backend/configs/*.yml
!backend/configs/*.example.yml
sync/configs/*.yml
!sync/configs/*.example.yml
# The CI tenant's vocabulary is tracked on purpose: every other config here
# carries tenant ids and SMTP credentials and so stays out of the repo, but the
# e2e workflow needs a config.yml on a fresh checkout to read the role
# definitions from. It holds roles, permissions and resources and nothing else.
!sync/configs/config.ci.yml
collect/configs/*.yml
!collect/configs/*.example.yml
*.config
config.json
config.yaml

# Local dev TLS certs (mkcert-generated per-machine — see proxy/Makefile dev-setup)
proxy/*.pem

# IDE
.idea/
.vscode/*
!.vscode/extensions.json

# Logs
*.log

# OS
.DS_Store
Thumbs.db

# Copilot instructions (local only)
.github/copilot-instructions.md
.github/instructions/frontend.instructions.md

# Claude Code local shim — points to AGENTS.md; each dev may keep their own
CLAUDE.md

# Playwright end-to-end suite: browsers, reports, traces and the per-persona
# storageState files (which hold live Logto sessions).
frontend/e2e/.auth/
frontend/playwright-report/
frontend/test-results/
frontend/blob-report/
frontend/.cache/ms-playwright/
