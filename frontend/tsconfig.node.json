{
  // The base config tracks the Node major pinned in /.nvmrc, like @types/node.
  // @tsconfig/node26 uses lib "es2025" and "ESNext.Temporal", which need
  // TypeScript >= 6.0: bump them together.
  "extends": "@tsconfig/node26/tsconfig.json",
  "include": [
    "vite.config.*",
    "vitest.config.*",
    "cypress.config.*",
    "nightwatch.conf.*",
    "eslint.config.*"
  ],
  "compilerOptions": {
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",

    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"]
  }
}
