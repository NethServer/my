# Address of the HTTP server: health check and the SSH-over-WebSocket endpoint (/api/ssh)
HTTP_LISTEN_ADDRESS=127.0.0.1:8083
# SSH host key, generated at the first start when missing
SSH_HOST_KEY_PATH=./ssh_host_key

# Where operators approve the access requests (the my frontend)
APP_URL=https://my.localtest.me
# Backend that opens the shells
BACKEND_URL=http://localhost:8080
# Same value as the backend's SUPPORT_INTERNAL_SECRET
SUPPORT_INTERNAL_SECRET=

# Redis shared with the backend (same database)
REDIS_URL=redis://localhost:6379
REDIS_DB=0
#REDIS_PASSWORD=

# How long ssh waits for the approval in the browser
#AUTH_TIMEOUT=5m
# How long an approved SSH key skips the browser (at most the backend grant, 4h)
#KEY_AUTH_TTL=4h
# Access requests a client IP can open per minute
#MAX_REQUESTS_PER_MINUTE=10

LOG_LEVEL=info
LOG_FORMAT=console
