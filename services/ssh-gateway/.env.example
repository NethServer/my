# Address of the HTTP server: health check and the SSH-over-WebSocket endpoint (/api/ssh)
HTTP_LISTEN_ADDRESS=127.0.0.1:8083
# SSH host key: it must never change, or every operator's ssh warns of a man
# in the middle. SSH_HOST_KEY holds the PEM itself (hosts without a persistent
# disk, e.g. Render); otherwise the key file is generated at the first start.
#SSH_HOST_KEY=
SSH_HOST_KEY_PATH=./ssh_host_key

# Backend: it keeps every piece of state (requests, approved keys, grants)
# and opens the shells. The gateway has no store and no other secret.
BACKEND_URL=http://localhost:8080
# Same value as the backend's SSH_GATEWAY_SECRET (openssl rand -hex 32)
SSH_GATEWAY_SECRET=

# How long ssh waits for the approval in the browser
#AUTH_TIMEOUT=5m
# How long a connection may take before its authentication starts
#HANDSHAKE_TIMEOUT=30s
# Access requests a client IP can open per minute
#MAX_REQUESTS_PER_MINUTE=10
# Connections not yet authenticated, per client IP and overall
#MAX_CONNS_PER_IP=10
#MAX_PENDING_CONNS=200

LOG_LEVEL=info
LOG_FORMAT=console
